[user]
	email = prok20@gmail.com
	name = Alexander Prokudin
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILgdpDNSYtp2vzBlDDmb9GDsEJY5HJKx/R96AQ7eLLot
[gpg]
  format = ssh
[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
[commit]
  gpgsign = true

[pull]
	ff = only
[help]
	autocorrect = 1
[github]
	user = prok20
[alias]
	c = commit
	s = status
	lg = log --oneline
	last = log -1 HEAD

[includeIf "gitdir/i:work/"]
	path = ~/.config/git/config-work

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
